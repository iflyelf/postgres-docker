# 复制为 .env 后按需修改: cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# ============ 初始化 ============
# 超级用户密码（默认 ysyh!9Sky，生产环境务必修改）
POSTGRES_PASSWORD=ysyh!9Sky
POSTGRES_USER=postgres
POSTGRES_DB=postgres            # 仅单机模式自动创建；集群模式请连上后手工建库

# ============ 自动调优(可选, 留空则自动探测 cgroup) ============
# 内存上限, 支持 8Gi / 4096Mi / 字节数
PG_MEMORY_LIMIT=
# CPU 上限, 支持 4 / 2.5 / 500m
PG_CPU_LIMIT=
# 直接指定连接数(配合 pgbouncer 等连接池时建议显式设置)
PG_MAX_CONNECTIONS=

# ============ 本地化 ============
TZ=Asia/Shanghai
LANG=zh_CN.UTF-8

# ============ 3 节点集群专用(docker-compose.cluster.yml) ============
# 流复制用户密码
REPLICATION_PASSWORD=repl-pass
# pg_rewind 用户密码
REWIND_PASSWORD=rewind-pass
# 集群作用域名称(同一 scope 的节点组成一个 Patroni 集群)
PATRONI_SCOPE=postgres-cluster
# Patroni 日志级别: DEBUG / INFO / WARNING / ERROR
PATRONI_LOG_LEVEL=INFO
# 是否按各节点 CPU/内存自动调优参数(false 关闭, 使用模板参数)
# etcd 集群引导令牌(3 节点 etcd 必须一致)
ETCD_CLUSTER_TOKEN=postgres-cluster
CLUSTER_AUTOTUNE=true
